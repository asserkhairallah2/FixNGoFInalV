<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Warnings are errors in product projects; test projects opt out via IsTestProject=true -->
    <TreatWarningsAsErrors Condition="'$(IsTestProject)' != 'true'">true</TreatWarningsAsErrors>
    <!-- AutoMapper 12.0.1 is mandated by the brief (v13+ is commercially licensed); NuGet audit
         flags known advisories in it. Suppress only that audit warning; recorded in DEVIATIONS.md. -->
    <NoWarn>$(NoWarn);1591;NU1903</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
