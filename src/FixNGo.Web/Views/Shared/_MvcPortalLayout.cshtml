<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "FixNGo Portal") — ASP.NET Core 8 MVC</title>
    <link rel="stylesheet" href="/assets/fixngo-app.css" asp-append-version="true" />
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen" style="user-select:auto;-webkit-user-select:auto;">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-20">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-[#E51C23] text-white font-black text-sm">FN</span>
          <div>
            <a asp-controller="Home" asp-action="Index" class="text-base font-black tracking-tight text-slate-900">Fix<span class="text-[#E51C23]">N</span>Go</a>
            <p class="text-[11px] text-slate-500">ASP.NET Core 8 MVC · Clean Architecture</p>
          </div>
        </div>
        <nav class="flex items-center gap-4 text-xs font-bold">
          <a asp-controller="Home" asp-action="Index" class="text-slate-600 hover:text-[#E51C23]">Mobile App</a>
          <a asp-controller="ServiceCentersMvc" asp-action="Index" class="text-slate-600 hover:text-[#E51C23]">Service Centers</a>
          <a asp-controller="ArchitectureMvc" asp-action="Index" class="text-slate-600 hover:text-[#E51C23]">Clean Architecture</a>
        </nav>
      </div>
    </header>
    <main class="max-w-5xl mx-auto px-6 py-8">
      @RenderBody()
    </main>
  </body>
</html>
