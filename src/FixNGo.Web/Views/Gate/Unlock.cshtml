@model FixNGo.Web.Controllers.GateUnlockViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-host="aspnet-core-mvc-gate">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FixNGo — Protected Environment Access</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Arial, sans-serif;
            background: radial-gradient(circle at top, #1e293b 0%, #0f172a 65%, #090d16 100%);
            color: #f8fafc;
        }
        .gate-card {
            width: 100%;
            max-width: 400px;
            background: rgba(15, 23, 42, 0.92);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 24px;
            padding: 32px 28px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }
        .shield {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(229, 28, 35, 0.16);
            border: 1px solid rgba(229, 28, 35, 0.45);
            display: grid;
            place-items: center;
            color: #E51C23;
            font-weight: 900;
            font-size: 18px;
        }
        .brand-title {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -0.02em;
        }
        .brand-title span { color: #E51C23; }
        h1 {
            margin: 0 0 6px;
            font-size: 18px;
            font-weight: 800;
        }
        p.sub {
            margin: 0 0 22px;
            font-size: 13px;
            color: #94a3b8;
            line-height: 1.5;
        }
        .alert {
            margin-bottom: 16px;
            padding: 11px 13px;
            border-radius: 12px;
            background: rgba(244, 63, 94, 0.14);
            border: 1px solid rgba(244, 63, 94, 0.45);
            color: #fda4af;
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.45;
        }
        .field { margin-bottom: 15px; }
        label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #cbd5e1;
            margin-bottom: 6px;
        }
        input {
            width: 100%;
            height: 44px;
            padding: 0 14px;
            border-radius: 12px;
            border: 1.5px solid rgba(255, 255, 255, 0.14);
            background: rgba(30, 41, 59, 0.85);
            color: #f8fafc;
            font-size: 14px;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        input:focus {
            border-color: #E51C23;
            box-shadow: 0 0 0 3px rgba(229, 28, 35, 0.22);
        }
        input.invalid {
            border-color: #f43f5e;
            box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.2);
        }
        button {
            width: 100%;
            height: 46px;
            margin-top: 6px;
            border: none;
            border-radius: 14px;
            background: #E51C23;
            color: #ffffff;
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: opacity 0.15s ease;
        }
        button:hover { opacity: 0.94; }
    </style>
</head>
<body>
    <main class="gate-card" data-testid="site-gate-card">
        <div class="brand">
            <div class="shield">🛡️</div>
            <div class="brand-title">Fix<span>N</span>Go</div>
        </div>
        <h1>Protected Environment</h1>
        <p class="sub">Enter the server access credentials to unlock FixNGo (session stays active automatically).</p>

        @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
        {
            <div class="alert" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post" action="/__site-gate" novalidate>
            <div class="field">
                <label for="gate-user">Username / اسم المستخدم</label>
                <input id="gate-user" name="username" type="text" autocomplete="username" value="@(Model?.Username ?? string.Empty)" class="@(Model?.UsernameMissing == true ? "invalid" : "")" placeholder="Username" />
            </div>
            <div class="field">
                <label for="gate-pass">Password / كلمة المرور</label>
                <input id="gate-pass" name="password" type="password" autocomplete="current-password" class="@(Model?.PasswordMissing == true ? "invalid" : "")" placeholder="••••••••" />
            </div>
            <button type="submit" data-testid="site-gate-submit">Unlock Environment</button>
        </form>
    </main>
    <script>
        if (window.location.pathname !== '/' || window.location.search || window.location.hash) {
            try { window.history.replaceState(null, '', '/'); } catch (e) {}
        }
    </script>
</body>
</html>
